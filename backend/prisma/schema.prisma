generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoEvidencia {
  DOCUMENTO
  PDF
  IMAGEN
  VIDEO
  ENLACE
}

enum ClaveSeccion {
  PRESENTACION
  INTRODUCCION
  CONCLUSION
  REFLEXION
}

model Unidad {
  id          Int         @id @default(autoincrement())
  titulo      String
  slug        String      @unique
  descripcion String      @db.Text
  imagenUrl   String?
  orden       Int         @unique
  evidencias  Evidencia[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Evidencia {
  id             Int           @id @default(autoincrement())
  titulo         String
  descripcion    String?       @db.Text
  contenido      String?       @db.Text
  tipo           TipoEvidencia
  archivoUrl     String?
  imagenUrl      String?
  palabrasClave  String[]      @default([])
  orden          Int           @default(0)
  unidadId       Int
  unidad         Unidad        @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Seccion {
  id          Int           @id @default(autoincrement())
  clave       ClaveSeccion  @unique
  titulo      String
  contenido   String        @db.Text
  imagenUrl   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
